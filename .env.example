# Optional: you can paste keys in the app instead (gear icon → API keys), where they are
# encrypted with your system keychain. Keys saved in the app take priority over these.

# Required for the default setup (voice, images, search, screen understanding):
GEMINI_API_KEY=

# Only needed if you pick these providers in Settings:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Only for the Porcupine wake-word engine (Settings → Wake word):
PICOVOICE_ACCESS_KEY=
