# ─────────────────────────────────────────────────────────────────────────────
# Ahdismoi configuration
#
# Copy this file to .env.local (recommended) or .env in the project folder:
#     macOS / Linux:   cp .env.example .env.local
#     Windows (cmd):   copy .env.example .env.local
#
# Everything here is OPTIONAL. You can do all of it from the in-app Settings panel
# (gear icon) instead. How the two interact:
#   • API keys pasted in Settings are stored encrypted and take priority over this file.
#   • Other settings below are DEFAULTS. Anything you change in the Settings panel
#     overrides them; "Reset to defaults" in the panel returns to what's in this file.
#   • Real environment variables beat .env.local, which beats .env.
#   • Leave a line empty (NAME=) to use the built-in default shown in the comment.
#   • Every AHDISMOI_ variable also works with the older RICKY_ prefix.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ API keys ═══════════════════════════════════════════════════════════════

# Google Gemini: needed for the default setup (voice, images, search, screen reading).
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI: only if you choose OpenAI for a task. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter: only if you choose OpenRouter for a task. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Exa: only if you choose Exa for web search. https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Picovoice: only for the Porcupine wake-word engine. https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=


# ═══ Names ══════════════════════════════════════════════════════════════════

# What the assistant calls you. Default: (empty, it says "the user")
AHDISMOI_USER_NAME=

# The assistant's name. Default: Ahdismoi
AHDISMOI_ASSISTANT_NAME=


# ═══ Models (one provider + model per task) ═════════════════════════════════
# Providers per task:
#   VOICE:                  gemini | openai
#   IMAGE, IMAGE_EDIT:      gemini | openai | openrouter
#   SEARCH:                 gemini | openai | openrouter | exa
#   VISION:                 gemini | openai | openrouter
# If you set a PROVIDER but leave its MODEL empty, that provider's first suggested model is used.
# Any model ID the provider accepts will work; the examples are only suggestions.

# Voice (realtime conversation, also decides which tools to call)
#   gemini: gemini-3.8-live (default), gemini-3.8-live-extended-thinking, gemini-2.5-flash-native-audio-preview-12-2025
#   openai: gpt-realtime-2
AHDISMOI_VOICE_PROVIDER=
AHDISMOI_VOICE_MODEL=
# Voice name. gemini: Charon (default), Puck, Kore, Fenrir, Aoede, Orus, Leda, Zephyr…
#             openai: cedar (default for openai), marin, alloy, ash, ballad, coral, echo, sage, shimmer, verse
AHDISMOI_VOICE_NAME=

# Image generation (standalone images + new thumbnails)
#   gemini: gemini-3.1-flash-image (default, "Nano Banana 2"), gemini-3.1-flash-lite-image, gemini-3-pro-image, gemini-2.5-flash-image
#   openai: gpt-image-2
#   openrouter: black-forest-labs/flux.2-klein-4b, qwen/qwen-image-3, qwen/qwen-image-3-pro, google/gemini-3.1-flash-image
AHDISMOI_IMAGE_PROVIDER=
AHDISMOI_IMAGE_MODEL=

# Image editing (thumbnail edits, and generations that use your reference photos)
#   Same choices as image generation. Default: gemini / gemini-3.1-flash-image
AHDISMOI_IMAGE_EDIT_PROVIDER=
AHDISMOI_IMAGE_EDIT_MODEL=

# Web search
#   gemini: gemini-3.8-flash (default; uses Google Search), gemini-3.5-flash-lite, gemini-2.5-flash
#   openai: gpt-5-mini, gpt-5 (uses OpenAI's web_search tool)
#   openrouter: google/gemini-3.8-flash, qwen/qwen3.8-omni-flash, deepseek/deepseek-chat (uses OpenRouter's web plugin)
#   exa: auto
AHDISMOI_SEARCH_PROVIDER=
AHDISMOI_SEARCH_MODEL=

# Screen understanding (reads screenshots in computer-control mode to find what to click)
#   gemini: gemini-3.8-flash (default), gemini-3.5-flash-lite, gemini-2.5-flash
#   openai: gpt-5-mini, gpt-5
#   openrouter: google/gemini-3.8-flash, qwen/qwen3.8-omni-flash (any vision-capable model)
AHDISMOI_VISION_PROVIDER=
AHDISMOI_VISION_MODEL=


# ═══ Voice behaviour ════════════════════════════════════════════════════════

# Stop sending your mic while the assistant is talking (Gemini voice only).
# Turn on if it keeps interrupting itself when you use speakers. Default: false
AHDISMOI_PAUSE_MIC_WHILE_SPEAKING=


# ═══ Wake word ══════════════════════════════════════════════════════════════

# Start in wake-word mode (always listening locally for the wake word). Default: false
AHDISMOI_WAKE_ENABLED=

# Engine: vosk (default; free, offline) | porcupine (needs PICOVOICE_ACCESS_KEY + a .ppn file chosen in Settings)
AHDISMOI_WAKE_ENGINE=

# Vosk only: the wake phrase as the speech model spells it. Every word must be in the model's
# vocabulary. Default: ah dis moi   (how the French model hears "Ahdismoi")
AHDISMOI_WAKE_PHRASE=

# 0.0 to 1.0. Higher = wakes more easily (and more false alarms). Default: 0.5
AHDISMOI_WAKE_SENSITIVITY=

# Go back to sleep after this many seconds without conversation (3 to 300). Default: 10
AHDISMOI_WAKE_SLEEP_AFTER_SECONDS=

# Vosk only: speech model to download on first use (.zip or .tar.gz). Default (French, ~41 MB, Apache-2.0):
#   https://alphacephei.com/vosk/models/vosk-model-small-fr-0.22.zip
# Other languages: https://alphacephei.com/vosk/models (pick a "small" model, then change WAKE_PHRASE).
AHDISMOI_VOSK_MODEL_URL=

# Porcupine only: language of your trained .ppn keyword: fr (default) | en
AHDISMOI_PORCUPINE_LANGUAGE=


# ═══ Linux ══════════════════════════════════════════════════════════════════

# On Wayland, the app window runs through XWayland so the floating face can position itself and
# stay on top. Set to 1 to run as a native Wayland window instead. Default: (off)
AHDISMOI_NATIVE_WAYLAND=

# Wayland computer control: path to the ydotoold socket. Usually auto-detected
# ($XDG_RUNTIME_DIR/.ydotool_socket after running `npm run setup:linux`).
YDOTOOL_SOCKET=


# ═══ Advanced / development ═════════════════════════════════════════════════

# Override the Gemini Live WebSocket endpoint (testing with a mock server). Default: Google's endpoint.
AHDISMOI_GEMINI_WS_URL=

# Set automatically by `npm run dev`; don't set this yourself.
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
